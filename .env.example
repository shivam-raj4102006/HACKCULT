PROJECT_NAME="HeritageProof"
VERSION="1.0.0"
ENVIRONMENT="production"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Optional: Remote PostgreSQL Database URL for persistent storage (e.g. Neon, Supabase, Vercel Postgres)
# If not provided, HeritageProof defaults to an ephemeral SQLite database in /tmp
# DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/heritageproof?sslmode=require"

# Optional: Allowed CORS Origins (comma-separated or JSON list)
# BACKEND_CORS_ORIGINS="https://heritageproof.vercel.app,http://localhost:5173"
