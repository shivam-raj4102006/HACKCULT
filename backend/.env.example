PROJECT_NAME="HeritageProof"
VERSION="1.0.0"
ENVIRONMENT="development"
SECRET_KEY="heritageproof-super-secret-jwt-key-2026-production-ready"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database: Default SQLite for easy zero-dependency run, or postgresql://user:pass@localhost:5432/heritageproof
DATABASE_URL="sqlite:///./heritageproof.db"

# Storage
STORAGE_DIR="./storage"
UPLOAD_DIR="./storage/uploads"
REPORT_DIR="./storage/reports"
MAX_UPLOAD_SIZE_BYTES=52428800
